{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compile Noteify Project",
            "command": "g++",
            "args": [
                "-Wall",
                "-std=c++17",
                "main.cpp",
                "User.cpp",
                "Note.cpp",
                "Notebook.cpp",
                "NoteService.cpp",
                "-o",
                "ManageNoteSystem.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}
